{
  "name": "cricapp",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "cricapp",
      "workspaces": [
        "apps/*",
        "packages/*",
        "services/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@cricapp/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@cricapp/web",
      "version": "0.0.0"
    },
    "node_modules/@cricapp/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@cricapp/ingestion": {
      "resolved": "services/ingestion",
      "link": true
    },
    "node_modules/@cricapp/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "node_modules/@cricapp/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared-types": {
      "name": "@cricapp/shared-types",
      "version": "0.0.0"
    },
    "services/ingestion": {
      "name": "@cricapp/ingestion",
      "version": "0.0.0",
      "dependencies": {
        "@cricapp/shared-types": "*"
      }
    }
  }
}
