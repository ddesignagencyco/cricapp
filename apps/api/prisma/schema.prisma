// Prisma schema for @cricapp/api
// Models mirror the existing `matches` table (created by services/ingestion
// data/init.sql) and add team / player data persisted by ingestion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Match {
  matchId        String   @id @map("match_id")
  status         String
  teams          Json
  teamNames      Json     @map("team_names")
  tournament     String?
  venue          String?
  scheduled      String?
  currentInnings Json?    @map("current_innings")
  lastEvent      Json     @map("last_event")
  displayScore   String?  @map("display_score")
  matchStatus    String?  @map("match_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([scheduled])
  @@index([tournament])
  @@map("matches")
}

model Team {
  id        String    @id
  name      String
  abbr      String
  country   String?
  logoUrl   String?   @map("logo_url")
  manager   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  players   Player[]

  @@index([abbr])
  @@map("teams")
}

model Player {
  id          String    @id
  fullName    String    @map("full_name")
  shortName   String?   @map("short_name")
  teamId      String?   @map("team_id")
  birth       String?
  nationality String?
  battingStyle String?  @map("batting_style")
  bowlingStyle String?  @map("bowling_style")
  role        String?
  profileUrl  String?   @map("profile_url")
  countryCode String?   @map("country_code")
  jerseyNumber Int?     @map("jersey_number")
  height      Int?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  team        Team?     @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@map("players")
}

// --- PSL records -----------------------------------------------------------
// Owned by the ingestion service (services/ingestion). The API reads them via
// Prisma. Season ids are Sportradar ids (e.g. sr:season:140552 for PSL 2026).

model PslStanding {
  id           Int     @id @default(autoincrement())
  seasonId     String  @map("season_id")
  teamId       String  @map("team_id")
  teamName     String  @map("team_name")
  teamAbbr     String  @map("team_abbr")
  rank         Int
  played       Int     @default(0)
  won          Int     @default(0)
  lost         Int     @default(0)
  tied         Int     @default(0)
  noResult     Int     @default(0) @map("no_result")
  points       Int     @default(0)
  netRunRate   Float   @default(0) @map("net_run_rate")
  runsFor      Int     @default(0) @map("runs_for")
  runsAgainst  Int     @default(0) @map("runs_against")
  oversFor     Float   @default(0) @map("overs_for")
  oversAgainst Float   @default(0) @map("overs_against")
  change       Int     @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, teamId])
  @@index([seasonId, rank])
  @@map("psl_standings")
}

model PslFixture {
  matchId      String   @id @map("match_id")
  seasonId     String   @map("season_id")
  status       String?
  scheduled    String?
  homeTeamId   String?  @map("home_team_id")
  homeTeamName String?  @map("home_team_name")
  homeTeamAbbr String?  @map("home_team_abbr")
  awayTeamId   String?  @map("away_team_id")
  awayTeamName String?  @map("away_team_name")
  awayTeamAbbr String?  @map("away_team_abbr")
  venue        String?
  resultText   String?  @map("result_text")
  round        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([seasonId])
  @@index([scheduled])
  @@map("psl_fixtures")
}

model PslLeader {
  id         Int    @id @default(autoincrement())
  seasonId   String @map("season_id")
  category   String
  stat       String
  rank       Int
  playerId   String @map("player_id")
  playerName String @map("player_name")
  teamAbbr   String? @map("team_abbr")
  teamName   String? @map("team_name")
  value      Float  @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, category, stat, playerId])
  @@index([seasonId, category, stat, rank])
  @@map("psl_leaders")
}

// --- Reference data & extended Sportradar endpoints ---------------------------
// Persisted by the ingestion service and read via the API. Where the raw
// Sportradar payload is deeply nested (timelines, meetings, sport events), the
// provider payload is stored as JSONB alongside lightweight indexed columns.

// Tour List endpoint -> tours
model Tour {
  id        String   @id
  name      String
  category  Json?
  sport     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tours")
}

// Tournament List endpoint -> tournaments (with current_season metadata)
model Tournament {
  id             String   @id
  name           String
  type           String?
  gender         String?
  category       Json?
  currentSeason  Json?    @map("current_season")
  sport          Json?
  tourId         String?  @map("tour_id")
  parentId       String?  @map("parent_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  seasons        TournamentSeason[]

  @@map("tournaments")
}

// Tournament Seasons endpoint -> seasons per tournament.
model TournamentSeason {
  id           String   @id
  tournamentId String   @map("tournament_id")
  name         String?
  year         String?
  startDate    String?  @map("start_date")
  endDate      String?  @map("end_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  @@index([tournamentId])
  @@map("tournament_seasons")
}

// Daily Schedule / Daily Results / Team Schedule / Team Results / Tournament Results
// all return the same rich `sport_event` shape. Store one row per event, keyed by
// a "kind" (daily_schedule, daily_results, team_schedule, team_results,
// tournament_results) and a scope (tournament/season/date id).
model SportEventRecord {
  id        Int      @id @default(autoincrement())
  kind      String
  scopeKey  String   @map("scope_key")
  eventId   String   @map("event_id")
  status    String?
  scheduled String?
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([kind, scopeKey, eventId])
  @@index([kind, scopeKey])
  @@map("sport_event_records")
}

// Match Timeline endpoint -> ball-by-ball timeline for a match (rich nested data).
model MatchTimeline {
  matchId   String   @id @map("match_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("match_timelines")
}

// Team Versus Team endpoint -> head-to-head meetings between two teams.
// Keyed deterministically by the ordered team pair so a single row covers both
// directions (the Sportradar endpoint accepts either ordering).
model HeadToHead {
  teamAId   String   @map("team_a_id")
  teamBId   String   @map("team_b_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([teamAId, teamBId])
  @@map("head_to_head")
}

// Team Profile endpoint -> team metadata + manager (enriches the teams table).
model TeamProfile {
  teamId    String   @id @map("team_id")
  manager   Json?
  teamInfo  Json?    @map("team_info")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("team_profiles")
}

// Player Profile endpoint -> rich per-format stats + team membership history.
model PlayerProfile {
  playerId  String   @id @map("player_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("player_profiles")
}

// --- Phase 4: User & Auth ---------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  isAdmin      Boolean  @default(false) @map("is_admin")
  emailVerified Boolean @default(false) @map("email_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  favorites    Favorite[]
  comments     Comment[]
  reactions    Reaction[]
  devices      Device[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationToken EmailVerificationToken?

  @@map("users")
}

// --- Phase 4: News / Feed ---------------------------------------------------

model NewsCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  articles  NewsArticle[]

  @@map("news_categories")
}

model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String?
  content     String   @db.Text
  imageUrl    String?  @map("image_url")
  author      String?
  source      String?
  categoryId  String?  @map("category_id")
  tags        Json?
  publishedAt DateTime? @map("published_at")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  category    NewsCategory? @relation(fields: [categoryId], references: [id])

  @@index([publishedAt])
  @@index([categoryId])
  @@map("news_articles")
}

// --- Phase 4: Live Streams --------------------------------------------------

model LiveStream {
  id           String   @id @default(uuid())
  title        String
  matchId      String?  @map("match_id")
  streamUrl    String   @map("stream_url")
  provider     String?
  thumbnailUrl String?  @map("thumbnail_url")
  status       String   @default("upcoming")
  scheduledAt  DateTime? @map("scheduled_at")
  startedAt    DateTime? @map("started_at")
  endedAt      DateTime? @map("ended_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([scheduledAt])
  @@map("live_streams")
}

// --- Phase 4: Favorites / Bookmarks -----------------------------------------

model Favorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("favorites")
}

// --- Phase 4: Comments & Reactions ------------------------------------------

model Comment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id])
  reactions  Reaction[]

  @@index([targetType, targetId])
  @@map("comments")
}

model Reaction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  commentId  String?  @map("comment_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id])
  comment    Comment? @relation(fields: [commentId], references: [id])

  @@unique([userId, targetType, targetId, emoji])
  @@index([targetType, targetId])
  @@map("reactions")
}

// --- Phase 4: Push Notifications (FCM) --------------------------------------

model Device {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  fcmToken    String   @unique @map("fcm_token")
  platform    String
  preferences Json     @default("{\"matchStart\":true,\"wicket\":true,\"milestone\":true,\"matchEnd\":true}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("devices")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  codeHash  String?  @map("code_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}
