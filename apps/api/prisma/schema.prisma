// Prisma schema for @cricapp/api
// Models mirror the existing `matches` table (created by services/ingestion
// data/init.sql) and add team / player data persisted by ingestion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Match {
  matchId        String   @id @map("match_id")
  status         String
  teams          Json
  teamNames      Json     @map("team_names")
  tournament     String?
  venue          String?
  scheduled      String?
  currentInnings Json?    @map("current_innings")
  lastEvent      Json     @map("last_event")
  displayScore   String?  @map("display_score")
  matchStatus    String?  @map("match_status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([scheduled])
  @@index([tournament])
  @@map("matches")
}

model Team {
  id        String    @id
  name      String
  abbr      String
  country   String?
  logoUrl   String?   @map("logo_url")
  manager   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  players   Player[]

  @@index([abbr])
  @@map("teams")
}

model Player {
  id          String    @id
  fullName    String    @map("full_name")
  shortName   String?   @map("short_name")
  teamId      String?   @map("team_id")
  birth       String?
  nationality String?
  battingStyle String?  @map("batting_style")
  bowlingStyle String?  @map("bowling_style")
  role        String?
  profileUrl  String?   @map("profile_url")
  countryCode String?   @map("country_code")
  jerseyNumber Int?     @map("jersey_number")
  height      Int?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  team        Team?     @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@map("players")
}

// --- PSL records -----------------------------------------------------------
// Owned by the ingestion service (services/ingestion). The API reads them via
// Prisma. Season ids are Sportradar ids (e.g. sr:season:140552 for PSL 2026).

model PslStanding {
  id           Int     @id @default(autoincrement())
  seasonId     String  @map("season_id")
  teamId       String  @map("team_id")
  teamName     String  @map("team_name")
  teamAbbr     String  @map("team_abbr")
  rank         Int
  played       Int     @default(0)
  won          Int     @default(0)
  lost         Int     @default(0)
  tied         Int     @default(0)
  noResult     Int     @default(0) @map("no_result")
  points       Int     @default(0)
  netRunRate   Float   @default(0) @map("net_run_rate")
  runsFor      Int     @default(0) @map("runs_for")
  runsAgainst  Int     @default(0) @map("runs_against")
  oversFor     Float   @default(0) @map("overs_for")
  oversAgainst Float   @default(0) @map("overs_against")
  change       Int     @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, teamId])
  @@index([seasonId, rank])
  @@map("psl_standings")
}

model PslFixture {
  matchId      String   @id @map("match_id")
  seasonId     String   @map("season_id")
  status       String?
  scheduled    String?
  homeTeamId   String?  @map("home_team_id")
  homeTeamName String?  @map("home_team_name")
  homeTeamAbbr String?  @map("home_team_abbr")
  awayTeamId   String?  @map("away_team_id")
  awayTeamName String?  @map("away_team_name")
  awayTeamAbbr String?  @map("away_team_abbr")
  venue        String?
  resultText   String?  @map("result_text")
  round        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([seasonId])
  @@index([scheduled])
  @@map("psl_fixtures")
}

model PslLeader {
  id         Int    @id @default(autoincrement())
  seasonId   String @map("season_id")
  category   String
  stat       String
  rank       Int
  playerId   String @map("player_id")
  playerName String @map("player_name")
  teamAbbr   String? @map("team_abbr")
  teamName   String? @map("team_name")
  value      Float  @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, category, stat, playerId])
  @@index([seasonId, category, stat, rank])
  @@map("psl_leaders")
}

// --- Reference data & extended Sportradar endpoints ---------------------------
// Persisted by the ingestion service and read via the API. Where the raw
// Sportradar payload is deeply nested (timelines, meetings, sport events), the
// provider payload is stored as JSONB alongside lightweight indexed columns.

// Tour List endpoint -> tours
model Tour {
  id        String   @id
  name      String
  category  Json?
  sport     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tours")
}

// Tournament List endpoint -> tournaments (with current_season metadata)
model Tournament {
  id             String   @id
  name           String
  type           String?
  gender         String?
  category       Json?
  currentSeason  Json?    @map("current_season")
  sport          Json?
  tourId         String?  @map("tour_id")
  parentId       String?  @map("parent_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  seasons        TournamentSeason[]

  @@map("tournaments")
}

// Tournament Seasons endpoint -> seasons per tournament.
model TournamentSeason {
  id           String   @id
  tournamentId String   @map("tournament_id")
  name         String?
  year         String?
  startDate    String?  @map("start_date")
  endDate      String?  @map("end_date")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  @@index([tournamentId])
  @@map("tournament_seasons")
}

// Daily Schedule / Daily Results / Team Schedule / Team Results / Tournament Results
// all return the same rich `sport_event` shape. Store one row per event, keyed by
// a "kind" (daily_schedule, daily_results, team_schedule, team_results,
// tournament_results) and a scope (tournament/season/date id).
model SportEventRecord {
  id        Int      @id @default(autoincrement())
  kind      String
  scopeKey  String   @map("scope_key")
  eventId   String   @map("event_id")
  status    String?
  scheduled String?
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([kind, scopeKey, eventId])
  @@index([kind, scopeKey])
  @@map("sport_event_records")
}

// Match Timeline endpoint -> ball-by-ball timeline for a match (rich nested data).
model MatchTimeline {
  matchId   String   @id @map("match_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("match_timelines")
}

// Team Versus Team endpoint -> head-to-head meetings between two teams.
// Keyed deterministically by the ordered team pair so a single row covers both
// directions (the Sportradar endpoint accepts either ordering).
model HeadToHead {
  teamAId   String   @map("team_a_id")
  teamBId   String   @map("team_b_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([teamAId, teamBId])
  @@map("head_to_head")
}

// Team Profile endpoint -> team metadata + manager (enriches the teams table).
model TeamProfile {
  teamId    String   @id @map("team_id")
  manager   Json?
  teamInfo  Json?    @map("team_info")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("team_profiles")
}

// Player Profile endpoint -> rich per-format stats + team membership history.
model PlayerProfile {
  playerId  String   @id @map("player_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("player_profiles")
}
