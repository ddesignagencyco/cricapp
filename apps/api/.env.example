# CricApp API Environment Variables
# Copy this file to .env and fill in your real values

API_PORT=3001
DATABASE_URL=postgresql://cricapp:cricapp_dev_password@localhost:5432/cricapp
# Integration tests derive `cricapp_test` automatically. Override if needed:
# TEST_DATABASE_URL=postgresql://cricapp:cricapp_dev_password@localhost:5432/cricapp_test
REDIS_URL=redis://localhost:6379

# Browser session cookie
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRY=7d
AUTH_COOKIE_NAME=cricapp_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_MS=604800000
# AUTH_COOKIE_DOMAIN=.example.com

# Optional: used by `npm run prisma:seed` to create the protected owner.
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Email settings
EMAIL_PROVIDER=smtp
EMAIL_FROM=your-email@gmail.com

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-16-char-app-password

# Resend (alternative)
# EMAIL_PROVIDER=resend
# EMAIL_FROM=onboarding@resend.dev
# RESEND_API_KEY=your-resend-api-key

# Cloudinary article images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (optional)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Optional: API key guard (leave empty to disable)
# API_KEY=your-secret-api-key
