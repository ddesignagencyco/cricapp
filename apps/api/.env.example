# CricApp API Environment Variables
# Copy this file to .env and fill in your real values

API_PORT=3001
PUBLIC_WEB_URL=https://pakcriczone.com
DATABASE_URL=postgresql://cricapp:cricapp_dev_password@localhost:5432/cricapp
# Integration tests derive `cricapp_test` automatically. Override if needed:
# TEST_DATABASE_URL=postgresql://cricapp:cricapp_dev_password@localhost:5432/cricapp_test
REDIS_URL=redis://localhost:6379

# Sportradar (on-demand head-to-head and match timelines when not in DB)
SPORTRADAR_API_KEY=
# SPORTRADAR_API_BASE_URL=https://api.sportradar.com

# Browser session cookie
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRY=7d
AUTH_COOKIE_NAME=cricapp_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE_MS=604800000
# AUTH_COOKIE_DOMAIN=.example.com

# Optional: used by `npm run prisma:seed` to create the protected owner.
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# Email settings
EMAIL_PROVIDER=smtp
EMAIL_FROM=your-email@gmail.com

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-16-char-app-password

# Resend (alternative)
# EMAIL_PROVIDER=resend
# EMAIL_FROM=onboarding@resend.dev
# RESEND_API_KEY=your-resend-api-key

# Cloudinary article images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (optional)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Optional: API key guard (leave empty to disable)
# API_KEY=your-secret-api-key

# Optional: NL copy for stored prediction runs (does not change probabilities).
# template | openai | opencode. If unset, OpenCode Go key wins, then OpenAI, else template.
# PREDICTION_NARRATIVE_PROVIDER=opencode
# PREDICTION_NARRATIVE_MODEL=glm-5.3-flash

# Cricket AI assistant (SRS §11) — templated answers by default
# ASSISTANT_LLM_ENABLED=true
# ASSISTANT_NARRATIVE_PROVIDER=opencode
# ASSISTANT_NARRATIVE_MODEL=glm-5.3-flash
# OPENAI_MODEL=gpt-4o-mini

# OpenCode Go (https://opencode.ai/docs/go/) — Chat Completions:
# OPENCODE_API_KEY=
# OPENCODE_GO_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Odds Intelligence (Phase 14) — off until compliance + licensed feeds
# ODDS_PUBLIC_ENABLED=false
# ODDS_ALLOWED_REGIONS=PK
# ODDS_AGE_GATING_REQUIRED=true
# ODDS_ADVERTISING_RESTRICTED=true
# ODDS_STALE_MINUTES=30
# Redis cache TTL for GET /odds/:matchId responses (0 disables caching)
# ODDS_CACHE_TTL_SECONDS=60
# Movement alert threshold (percent change; 0 disables)
# ODDS_MOVEMENT_ALERT_PERCENT=10
# Retention period for settled snapshots (days)
# ODDS_RETENTION_DAYS=90
# Prune interval (ms)
# ODDS_PRUNE_INTERVAL_MS=86400000
# Configurable CDN geo headers for per-request region detection (comma-separated, order matters)
# ODDS_REGION_HEADER=cf-ipcountry,x-vercel-ip-country
# Force snapshot insertion even when price unchanged (for debugging)
# ODDS_FORCE_SNAPSHOTS=false

# Cricket AI assistant (SRS §11) — templated answers by default
# ASSISTANT_LLM_ENABLED=true
# ASSISTANT_NARRATIVE_PROVIDER=opencode
# ASSISTANT_NARRATIVE_MODEL=glm-5.3-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENCODE_API_KEY=   # same OpenCode Go endpoint as prediction narrative
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
