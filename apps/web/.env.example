NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001

# Google AdSense (see apps/web/docs/ads.md). Never commit a real publisher id.
# Stored site-settings `ads.clientId` wins when present; this is the fallback.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Page-level Auto Ads eligibility (anchor/vignette also need dashboard opt-in).
# Off by default — set to 1 to enable.
NEXT_PUBLIC_ADSENSE_AUTO_ADS=
NEXT_PUBLIC_ADSENSE_ANCHOR=
NEXT_PUBLIC_ADSENSE_VIGNETTE=