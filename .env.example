# Copy to `.env` locally. Real values live in Railway / Render / Vercel, not in git.

# Sportradar (ingestion)
SPORTRADAR_API_KEY=
SPORTRADAR_API_BASE_URL=https://api.sportradar.com

# Cache / pub-sub
REDIS_URL=

# Postgres (api + ingestion)
DATABASE_URL=

# apps/api
API_PORT=3001

# apps/web (browser-safe prefix only)
NEXT_PUBLIC_API_URL=http://localhost:3001
