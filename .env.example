# ── Database ──────────────────────────────────────────
POSTGRES_USER=cricapp
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=cricapp
DATABASE_URL=postgresql://cricapp:CHANGE_ME_IN_PRODUCTION@localhost:5432/cricapp

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────
API_PORT=3001
API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
CORS_ORIGINS=*
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Ingestion ─────────────────────────────────────────
SPORTRADAR_API_KEY=your_sportradar_api_key_here
POLL_INTERVAL_MS=30000
PSL_SEASONS=
PSL_SYNC_INTERVAL_MS=

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=info
