DATABASE_URL=
REDIS_URL=

# How often to re-score upcoming matches (default 15 minutes).
# PREMATCH_INTERVAL_MS=900000
# Upcoming fixture horizon (default 30 days).
# PREMATCH_HORIZON_HOURS=720
# Recalibration from settled matches (hourly by default).
# CALIBRATION_INTERVAL_MS=3600000
# CALIBRATION_MIN_SAMPLES=8
# Freeze operator-set params and skip auto-fit.
# PREMATCH_CALIBRATION_LOCKED=false
# Fallback when no fitted row exists yet.
# PREMATCH_CALIBRATION_SLOPE=1
# PREMATCH_CALIBRATION_INTERCEPT=0

# Minimum gap between live prediction runs for the same match.
# LIVE_THROTTLE_MS=15000

# How often to refresh Redis live-set subscriptions.
# LIVE_REFRESH_MS=5000
