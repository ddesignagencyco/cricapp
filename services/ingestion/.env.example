SPORTRADAR_API_KEY=
SPORTRADAR_API_BASE_URL=https://api.sportradar.com
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://cricapp:cricapp_dev_password@localhost:5432/cricapp

# Poll interval when live matches are active vs idle (no live matches).
# Keep live polling privileged over background Sportradar work.
# POLL_INTERVAL_LIVE_MS=15000
# POLL_INTERVAL_IDLE_MS=60000
# Pause heavy PSL/reference sync while any match is live (protects QPS).
# PAUSE_REF_SYNC_WHEN_LIVE=true
# PAUSE_PSL_SYNC_WHEN_LIVE=true

# Max Sportradar QPS (1 = trial tier; raise for purchased tiers).
# SPORTRADAR_QPS=1

# Capture live ball-by-ball timelines via delta endpoint (one extra call per
# live match per poll while on; flushes to Postgres when the match finishes).
# LIVE_TIMELINE_DELTAS=true
# Full timeline.json every N live poll cycles while status=live (default 3; 0=off).
# LIVE_TIMELINE_SNAPSHOT_EVERY=3
#
# Full Match Summary JSON is stored on sport_event_records (kind=match_summary)
# on live poll and via reference sync for scheduled/completed matches.

# PSL sync: comma-separated years or season ids (defaults to all seasons).
# PSL_SEASONS=2026,2025
# Periodic re-sync (default 3600000 = hourly when unset). Set 0 to disable repeats.
# PSL_SYNC_INTERVAL_MS=3600000
# Delay before first PSL sync on service start (default 0 — UI depends on PSL Postgres rows).
# PSL_START_DELAY_MS=0

# Reference/statistics endpoints sync (tours, tournaments, daily schedule &
# results, team/player profiles, timelines, head-to-head). Runs at startup and
# then on REFERENCE_SYNC_INTERVAL_MS (default 1h; 0 disables periodic).
#
# Targets are auto-derived from what has already been ingested and each step is
# gated by a per-target staleness stamp (Redis), so already-fresh static lists
# are skipped. Optional overrides below ADD to those derived sets (all comma-
# separated):
# REFERENCE_SYNC_INTERVAL_MS=3600000
# REFERENCE_SYNC_PAST_DAYS=2
# REFERENCE_SYNC_FUTURE_DAYS=30
# Delay heavy reference sync so live poll + PSL can use trial quota first.
# REF_SYNC_START_DELAY_MS=300000
# REF_SYNC_DELAY_MS=500
# REF_SYNC_MATCH_LIMIT=20
# REF_SYNC_SUMMARY_LIMIT=20
# REF_SYNC_SEASON_LIMIT=10
# REF_SYNC_TEAMS_LIMIT=10
# REF_SYNC_HEAD_TO_HEAD_LIMIT=50
# REF_SYNC_TEAM_IDS=sr:competitor:107203,sr:competitor:142690
# REF_SYNC_PLAYER_IDS=sr:player:646278
# REF_SYNC_PAIR_IDS=sr:competitor:107203::sr:competitor:142690

# One-shot full Postgres fill (PSL, daily, teams, summaries, timelines, news):
#   npm run fill-db
# Env: FILL_DAYS, FILL_DELAY_MS, FILL_TIMELINE_MAX, FILL_TEAM_IDS, FILL_SKIP_NEWS, …
# See scripts/fill-db.mjs header for all FILL_* options.

# Lighter Sportradar backfill (npm run backfill). Re-run until backfill:status
# shows timelines_still_queued: 0. BACKFILL_FULL_REF_SYNC=true hits many global seasons (429 on trial).
# BACKFILL_DAYS=45
# BACKFILL_TIMELINE_MAX=500
# BACKFILL_TIMELINE_BATCH=40
# BACKFILL_DELAY_MS=1500
# BACKFILL_TEAM_IDS=sr:competitor:107203,...

# News / Feed ingestion -------------------------------------------------------
# JSON array of RSS/Atom sources to poll. Each object needs: url, source (name),
# category (default category slug), and optional enabled flag.
# Production-ready Pakistan, PSL and international feed set. Override this
# value in the deployed environment to add/remove editorially approved feeds.
NEWS_SOURCES=[{"url":"https://news.google.com/rss/search?q=Pakistan+cricket&hl=en-PK&gl=PK&ceid=PK:en","source":"Google News - Pakistan Cricket","category":"Pakistan Cricket","enabled":true},{"url":"https://news.google.com/rss/search?q=Pakistan+Super+League&hl=en-PK&gl=PK&ceid=PK:en","source":"Google News - PSL","category":"PSL","enabled":true},{"url":"https://www.espncricinfo.com/rss/content/story/feeds/0.xml","source":"ESPNcricinfo","category":"International","enabled":true}]
# NEWS_SYNC_INTERVAL_MS=3600000

# Live stream metadata (optional) ---------------------------------------------
# JSON array of stream entries upserted into live_streams on a schedule.
# STREAM_SOURCES=[{"title":"PSL Final","matchId":"sr:match:1","streamUrl":"https://youtube.com/embed/x","provider":"YouTube","status":"upcoming"}]
# STREAM_SYNC_INTERVAL_MS=3600000

# Odds Intelligence (Phase 14) — NOT the cricket stats API -------------------
# Bookmaker prices require Sportradar Odds Comparison (separate license/key).
# SPORTRADAR_ODDS_ENABLED=true
# SPORTRADAR_ODDS_API_KEY=
# SPORTRADAR_ODDS_CRICKET_SPORT_ID=
# SPORTRADAR_ODDS_API_BASE_URL=https://api.sportradar.com
# ODDS_SYNC_INTERVAL_MS=300000
# Dev demo rows (requires migration): npm run seed:odds-demo -- sr:match:YOUR_ID

# Data provider -----------------------------------------------------------------
# sportradar (default) | cricbuzz | auto (= cricbuzz)
# `cricbuzz` reads everything from the official Cricbuzz Cricket listing on RapidAPI
# (cricbuzz-cricket.p.rapidapi.com): live matches, scorecards, ball-by-ball commentary,
# PSL fixtures / points tables / leaders / squads, team rosters, player profiles and the
# tournament catalogue. One host, one response cache, one request budget.
# DATA_PROVIDER=cricbuzz
# RAPIDAPI_KEY=
# RAPIDAPI_CRICBUZZ_HOST=cricbuzz-cricket.p.rapidapi.com
#
# Quota presets — set these to the plan you pay for (calls are blocked locally once the
# monthly budget is spent; cached responses cost nothing):
#
#   setting                          Basic(200/mo)  Pro(20k/mo)  Ultra(300k/mo)
#   RAPIDAPI_CRICBUZZ_MONTHLY_BUDGET     190          19000         290000
#   RAPIDAPI_MIN_INTERVAL_MS            1200            150            60     (plan's per-second limit)
#   RAPIDAPI_LIVE_TTL_S                  300            120            30     (live list / scorecard / commentary refresh)
#   POLL_MAX_LIVE_MATCHES                  1              1             4     (in-play matches followed; 0 = all)
#   RAPIDAPI_COMM_BACKFILL_PAGES           0             10           150     (older commentary pages, once per match; ~20 balls each)
#
# Rough cost: each followed live match spends ~3 requests per RAPIDAPI_LIVE_TTL_S window
# (live list, scorecard, commentary): at 30s that is ~360/hour, at 120s ~90/hour.
# Basic cannot carry a live site; use it for local smoke tests only.
#
# RAPIDAPI_CRICBUZZ_MONTHLY_BUDGET=200
# RAPIDAPI_MIN_INTERVAL_MS=1200
# RAPIDAPI_LIVE_TTL_S=60
# RAPIDAPI_LIST_TTL_S=21600           (recent/upcoming lists; a daily schedule reads 3 pages, so keep this long)
# RAPIDAPI_REF_TTL_S=86400            (PSL / catalogue / squads are cached a day)
# RAPIDAPI_COMM_BACKFILL_PAGES=150  (about 20 balls per page; 150 covers a five-day Test)
# POLL_MAX_LIVE_MATCHES=2
# RAPIDAPI_CATALOGUE_YEARS=2026,2025  (archive years included in the tournament catalogue)
# CRICBUZZ_SERIES_MAP={"sr:season:999999":12345}   (extra app season id -> Cricbuzz series id)
# PSL 2025 has no upstream points table, so its standings are derived from results (points,
# record and order are reliable; net run rate is approximate when rain-reduced games are involved).
# Reference-sync extras (0 = off). Each costs provider requests, so keep them small:
# REF_SYNC_TOURNAMENT_LIMIT=30   current catalogue tournaments: results + team list (1 request each)
# REF_SYNC_UPCOMING_TEAM_LIMIT=20  teams in upcoming/live matches: recent results for predictions (1 request each)
# REF_SYNC_SCORECARD_LIMIT=20    completed matches missing a scorecard (1 request each)
# Not available from Cricbuzz: lineups, team profiles and odds (head-to-head is built from
# team results). Those steps are skipped with a log line.
